default_platform(:ios)

platform :ios do
  desc "Run SwiftLint on iOS codebase"
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      config_file: ".swiftlint.yml"
    )
  end

  desc "Build and run unit tests"
  lane :test do
    scan(
      scheme: "TriageApp",
      workspace: "Triage.xcworkspace",
      devices: ["iPhone 15"]
    )
  end

  desc "Deploy beta to TestFlight via Fastlane Pilot"
  lane :beta do
    match(type: "appstore", readonly: true)
    increment_build_number(xcodeproj: "Triage.xcodeproj")
    build_app(
      scheme: "TriageApp",
      workspace: "Triage.xcworkspace",
      export_method: "app-store"
    )
    pilot(
      skip_waiting_for_build_processing: true
    )
  end
end
